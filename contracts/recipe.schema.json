{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datafoundry.example/recipe/v1",
  "title": "AI Data Foundry Recipe v1 (planning contract)",
  "type": "object",
  "required": ["name", "schema_version", "nodes", "edges", "budget"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "schema_version": {"const": "1.0"},
    "description": {"type": "string", "maxLength": 4000},
    "nodes": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["currency", "maximum"], "properties": {"currency": {"const": "USD"}, "maximum": {"type": "number", "minimum": 0}}},
    "metadata": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
  },
  "additionalProperties": false,
  "$defs": {
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "type", "config"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"}, "type": {"enum": ["ingest", "generate", "transform", "validate", "annotate", "simulate", "publish", "export"]}, "config": {"type": "object"}, "resource_requirements": {"type": "object"}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}
  },
  "$comment": "Schema checks shape only; DAG acyclicity, compatible I/O modalities, rights, limits and device capability must be validated server-side."
}
